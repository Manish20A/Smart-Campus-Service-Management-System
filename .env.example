# ==============================================================================
# CampusDesk — Environment Configuration Template
# ==============================================================================

# Public Web URL (e.g., http://localhost:3000 in dev or https://campusdesk.vercel.app)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Firebase Client SDK Configuration (Console -> Project Settings -> General)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyYourFirebaseApiKeyHere
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# ------------------------------------------------------------------------------
# Firebase Admin SDK Configuration (Console -> Project Settings -> Service Accounts)
# Generate a new private key and paste the contents here.
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
# Wrap the multiline private key with double quotes and retain \n escaped newlines
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# ------------------------------------------------------------------------------
# Resend Email API Key (https://resend.com/api-keys)
# ------------------------------------------------------------------------------
RESEND_API_KEY=re_123456789abcdefghijklmnopqrstuvwxyz

# ------------------------------------------------------------------------------
# Vercel Cron Security Secret (Used to authenticate /api/cron/escalate)
# ------------------------------------------------------------------------------
CRON_SECRET=campusdesk_super_secret_cron_token_2026
